{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "missing": [{ "type": "header", "key": "cf-ray" }],
      "destination": "https://www.decathlon.in/page/kiprun-series",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/page/kiprun-series", "destination": "/" },
    { "source": "/page/kiprun-series/", "destination": "/" },
    { "source": "/page/kiprun-series/:path*", "destination": "/:path*" }
  ]
}
